# --- required ---------------------------------------------------------
# From @BotFather (https://t.me/BotFather) -> /newbot -> copy the token
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- owner alerts (recommended) ---------------------------------------
# Easiest: leave empty, run scripts/bootstrap_owner.py — the first person
# who messages the bot becomes the owner (auto-detected & saved here).
# Manual: DM the bot /id and paste the user id below.
OWNER_ID=

# --- optional free LLM fallback (never a paid dependency) -------------
# Any OpenAI-compatible endpoint works. Groq free tier example:
#   https://console.groq.com  (free API key, OpenAI-compatible)
# Leave empty for pure keyword mode — the bot works fully without it.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# --- misc --------------------------------------------------------------
LOG_LEVEL=INFO
# CONFIG_PATH=config.yaml
